<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <include layout="@layout/layout_base_screen" />
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">
        <LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="64dp" ns0:gravity="center_vertical" ns0:paddingStart="8dp" ns0:paddingEnd="12dp">
        
                <TextView ns0:id="@+id/buttonBackToSettings" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:layout_weight="1" ns0:background="@drawable/bg_link_ripple" ns0:clickable="true" ns0:focusable="true" ns0:padding="12dp" ns0:text="@string/profile_details_back_title" ns0:textColor="@color/text_primary" ns0:textSize="20sp" ns0:textStyle="bold" />
        
                <TextView ns0:id="@+id/buttonEditProfile" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_link_ripple" ns0:clickable="true" ns0:focusable="true" ns0:padding="12dp" ns0:text="@string/profile_details_edit" ns0:textColor="@color/button_primary" ns0:textSize="16sp" ns0:textStyle="bold" />
        
            </LinearLayout>
        
            
        <ScrollView xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="0dp" ns0:layout_weight="1" ns0:fillViewport="true" ns0:overScrollMode="never">
        
                <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:paddingStart="8dp" ns0:paddingTop="8dp" ns0:paddingEnd="8dp" ns0:paddingBottom="32dp">
        
                    <TextView ns0:id="@+id/profileDetailsEmpty" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_screen_card" ns0:padding="20dp" ns0:text="@string/profile_details_empty" ns0:textColor="@color/text_secondary" ns0:textSize="15sp" ns0:visibility="gone" />
        
                    <LinearLayout ns0:id="@+id/profileDetailsContent" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_screen_card" ns0:orientation="vertical" ns0:padding="18dp" ns0:visibility="gone" />
        
                </LinearLayout>
        
            </ScrollView>
        
        
    </LinearLayout>
</merge>
