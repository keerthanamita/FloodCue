<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <include layout="@layout/layout_base_screen" />
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">
        <LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="64dp" ns0:gravity="center_vertical" ns0:paddingStart="8dp" ns0:paddingEnd="20dp">
        
                <TextView ns0:id="@+id/buttonBackToSettingsFromAbout" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_link_ripple" ns0:clickable="true" ns0:focusable="true" ns0:padding="12dp" ns0:text="@string/about_floodcue_back_title" ns0:textColor="@color/text_primary" ns0:textSize="20sp" ns0:textStyle="bold" />
        
            </LinearLayout>
        
            
        <ScrollView xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="0dp" ns0:layout_weight="1" ns0:fillViewport="true" ns0:overScrollMode="never">
        
                <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:paddingStart="8dp" ns0:paddingTop="8dp" ns0:paddingEnd="8dp" ns0:paddingBottom="32dp">
        
                    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_screen_card" ns0:orientation="vertical" ns0:padding="18dp">
        
                        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="@string/about_floodcue_heading" ns0:textColor="@color/text_primary" ns0:textSize="24sp" ns0:textStyle="bold" />
        
                        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:layout_marginTop="6dp" ns0:text="@string/about_floodcue_tagline" ns0:textColor="@color/text_primary" ns0:textSize="17sp" ns0:textStyle="bold" />
        
                        <TextView ns0:id="@+id/aboutFloodcueVersion" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:layout_marginTop="10dp" ns0:background="@drawable/bg_badge_pill" ns0:paddingStart="10dp" ns0:paddingTop="5dp" ns0:paddingEnd="10dp" ns0:paddingBottom="5dp" ns0:textColor="@color/home_card_text" ns0:textSize="12sp" ns0:textStyle="bold" />
        
                        <TextView style="@style/AboutBodyText" ns0:layout_marginTop="12dp" ns0:text="@string/about_floodcue_intro" ns0:textColor="@color/text_primary" ns0:textSize="15sp" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:layout_marginTop="18dp" ns0:text="@string/about_floodcue_section_features" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_floodcue_features_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:layout_marginTop="18dp" ns0:text="@string/about_floodcue_section_languages" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_floodcue_languages_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:layout_marginTop="18dp" ns0:text="@string/about_floodcue_section_privacy" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_floodcue_privacy_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:layout_marginTop="18dp" ns0:text="@string/about_floodcue_section_sources" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_floodcue_sources_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:layout_marginTop="18dp" ns0:text="@string/about_floodcue_section_limits" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_floodcue_limits_body" />
        
                        <TextView style="@style/AboutBodyText" ns0:layout_marginTop="16dp" ns0:text="@string/about_floodcue_safety_reminder" ns0:textColor="@color/text_primary" ns0:textSize="15sp" ns0:textStyle="bold" />
        
                    </LinearLayout>
        
                </LinearLayout>
        
            </ScrollView>
        
        
    </LinearLayout>
</merge>
