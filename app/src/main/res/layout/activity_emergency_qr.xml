<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/layout_base_screen" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/buttonBackFromEmergencyQr" android:layout_width="wrap_content" android:layout_height="56dp" android:gravity="center_vertical" android:padding="12dp" android:text="@string/emergency_qr_back" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/emergency_qr_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/emergencyQrStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <ImageView android:id="@+id/emergencyQrImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="24dp" android:adjustViewBounds="true" android:contentDescription="@string/emergency_qr_image" />
        <Button android:id="@+id/buttonRevokeEmergencyQr" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/emergency_qr_revoke" android:textAllCaps="false" />
        <Button android:id="@+id/buttonOpenEmergencyQrScanner" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/emergency_qr_open_scanner" android:textAllCaps="false" />
        <Button android:id="@+id/buttonOpenEmergencyQrAdmin" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/emergency_qr_open_admin" android:textAllCaps="false" />
    </LinearLayout>
</merge>
