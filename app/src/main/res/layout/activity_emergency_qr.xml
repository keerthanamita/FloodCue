<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/layout_base_screen" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingBottom="40dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/emergency_qr_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/emergencyQrStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <ImageView android:id="@+id/emergencyQrImage" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" android:adjustViewBounds="true" android:contentDescription="@string/emergency_qr_image" />
            <Button android:id="@+id/buttonSaveEmergencyQr" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/emergency_qr_save" android:textAllCaps="false" />
            <Button android:id="@+id/buttonRevokeEmergencyQr" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/emergency_qr_revoke" android:textAllCaps="false" />
            <Button android:id="@+id/buttonOpenEmergencyQrScanner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/emergency_qr_open_scanner" android:textAllCaps="false" />
            <Button android:id="@+id/buttonOpenEmergencyQrAdmin" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/emergency_qr_open_admin" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</merge>
