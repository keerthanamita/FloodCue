<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <include layout="@layout/layout_base_screen" />

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
            ns0:layout_width="match_parent"
            ns0:layout_height="64dp"
            ns0:gravity="center_vertical"
            ns0:paddingStart="8dp"
            ns0:paddingEnd="20dp">

            <TextView
                ns0:id="@+id/buttonBackToCatalog"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:background="@drawable/bg_link_ripple"
                ns0:clickable="true"
                ns0:focusable="true"
                ns0:padding="12dp"
                ns0:textColor="@color/text_primary"
                ns0:textSize="20sp"
                ns0:textStyle="bold" />

        </LinearLayout>


        <FrameLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
            ns0:layout_width="match_parent"
            ns0:layout_height="0dp"
            ns0:layout_weight="1">

            <org.maplibre.android.maps.MapView
                ns0:id="@+id/mapView"
                ns0:layout_width="match_parent"
                ns0:layout_height="match_parent" />

            <TextView
                ns0:id="@+id/statusText"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_gravity="top|center_horizontal"
                ns0:layout_margin="12dp"
                ns0:background="@drawable/bg_screen_card"
                ns0:elevation="8dp"
                ns0:paddingHorizontal="14dp"
                ns0:paddingVertical="10dp"
                ns0:textColor="@color/text_primary"
                ns0:textSize="14sp"
                ns0:visibility="gone" />

        </FrameLayout>


    </LinearLayout>
</merge>
