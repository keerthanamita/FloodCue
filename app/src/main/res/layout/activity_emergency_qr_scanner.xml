<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/layout_base_screen" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/buttonBackFromEmergencyQrScanner" android:layout_width="wrap_content" android:layout_height="56dp" android:gravity="center_vertical" android:padding="12dp" android:text="@string/emergency_qr_back" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/emergency_qr_scanner_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
        <Button android:id="@+id/buttonStartEmergencyQrScan" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/emergency_qr_scan_start" android:textAllCaps="false" />
        <TextView android:id="@+id/emergencyQrScanResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_screen_card" android:padding="20dp" android:textColor="@color/text_primary" android:textSize="16sp" />
    </LinearLayout>
</merge>
