<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/layout_base_screen" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/buttonBackFromEmergencyQrAdmin" android:layout_width="wrap_content" android:layout_height="56dp" android:gravity="center_vertical" android:padding="12dp" android:text="@string/emergency_qr_back" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/emergency_qr_admin_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
        <EditText android:id="@+id/emergencyQrAdminUid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/emergency_qr_admin_uid_hint" android:inputType="text" />
        <Button android:id="@+id/buttonAuthorizeEmergencyScanner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="@string/emergency_qr_admin_authorize" android:textAllCaps="false" />
        <Button android:id="@+id/buttonRevokeEmergencyScanner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/emergency_qr_admin_revoke" android:textAllCaps="false" />
        <TextView android:id="@+id/emergencyQrAdminStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
    </LinearLayout>
</merge>
