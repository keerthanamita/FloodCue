<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_screen_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to FloodCue"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Home screen"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/buttonOfflineMaps"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_offline_maps"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonEmergencyContacts"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_emergency_contacts"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonSosEmergencyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_sos_emergency_message"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />                <Button
                    android:id="@+id/buttonEmergencyGuide"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_emergency_guide"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonOfflineCommunication"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_offline_communication"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_flood_checklist"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonTips"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_safety_tips"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                android:id="@+id/buttonSiren"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:minHeight="0dp"
                android:text="@string/home_siren"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="16sp" />

                <Button
                android:id="@+id/buttonSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

            </LinearLayout>
            <!-- Temporary local profile check -->
            <Button
                android:id="@+id/btnViewSavedDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="View Saved Setup Details" />

            <ScrollView
                android:id="@+id/savedDetailsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtSavedDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textIsSelectable="true" />

            </ScrollView>

        </LinearLayout>

    </ScrollView>


</LinearLayout>