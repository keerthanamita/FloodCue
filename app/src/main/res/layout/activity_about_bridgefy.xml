<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/buttonBackToSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_link_ripple"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/about_bridgefy_back_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_screen_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_bridgefy_heading"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_bridgefy_tagline"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_intro" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_company" />

                <TextView
                    style="@style/AboutBodyText"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_bridgefy_company_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_technology" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_technology_intro" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_bluetooth" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_bluetooth_body" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_mesh" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_mesh_body" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_ai" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_ai_body" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_offline" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_offline_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_products" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_products_intro" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_app" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_app_body" />

                <TextView
                    style="@style/AboutSubsectionTitle"
                    android:text="@string/about_bridgefy_subsection_sdk" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_sdk_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_security" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_security_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_applications" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_applications_intro" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_applications_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_floodcue" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_floodcue_body" />

                <TextView
                    style="@style/AboutSectionTitle"
                    android:text="@string/about_bridgefy_section_limitations" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_limitations_intro" />

                <TextView
                    style="@style/AboutBodyText"
                    android:text="@string/about_bridgefy_limitations_body" />

                <TextView
                    style="@style/AboutBodyText"
                    android:layout_marginTop="14dp"
                    android:text="@string/about_bridgefy_safety_reminder"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonOpenBridgefyWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/about_bridgefy_open_website"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonGetBridgefyApp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:text="@string/about_bridgefy_get_app"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
