<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <include layout="@layout/layout_base_screen" />
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">
        <LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="64dp" ns0:gravity="center_vertical" ns0:paddingStart="8dp" ns0:paddingEnd="20dp">
        
                <TextView ns0:id="@+id/buttonBackToSettings" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_link_ripple" ns0:clickable="true" ns0:focusable="true" ns0:padding="12dp" ns0:text="@string/about_bridgefy_back_title" ns0:textColor="@color/text_primary" ns0:textSize="20sp" ns0:textStyle="bold" />
        
            </LinearLayout>
        
            
        <ScrollView xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="0dp" ns0:layout_weight="1" ns0:fillViewport="true" ns0:overScrollMode="never">
        
                <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:paddingStart="8dp" ns0:paddingTop="8dp" ns0:paddingEnd="8dp" ns0:paddingBottom="32dp">
        
                    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:background="@drawable/bg_screen_card" ns0:orientation="vertical" ns0:padding="18dp">
        
                        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="@string/about_bridgefy_heading" ns0:textColor="@color/text_primary" ns0:textSize="24sp" ns0:textStyle="bold" />
        
                        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:layout_marginTop="10dp" ns0:text="@string/about_bridgefy_tagline" ns0:textColor="@color/text_primary" ns0:textSize="17sp" ns0:textStyle="bold" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_intro" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_company" />
        
                        <TextView style="@style/AboutBodyText" ns0:layout_marginTop="8dp" ns0:text="@string/about_bridgefy_company_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_technology" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_technology_intro" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_bluetooth" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_bluetooth_body" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_mesh" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_mesh_body" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_ai" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_ai_body" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_offline" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_offline_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_products" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_products_intro" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_app" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_app_body" />
        
                        <TextView style="@style/AboutSubsectionTitle" ns0:text="@string/about_bridgefy_subsection_sdk" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_sdk_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_security" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_security_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_applications" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_applications_intro" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_applications_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_floodcue" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_floodcue_body" />
        
                        <TextView style="@style/AboutSectionTitle" ns0:text="@string/about_bridgefy_section_limitations" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_limitations_intro" />
        
                        <TextView style="@style/AboutBodyText" ns0:text="@string/about_bridgefy_limitations_body" />
        
                        <TextView style="@style/AboutBodyText" ns0:layout_marginTop="14dp" ns0:text="@string/about_bridgefy_safety_reminder" ns0:textColor="@color/text_primary" ns0:textStyle="bold" />
        
                        <Button ns0:id="@+id/buttonOpenBridgefyWebsite" ns0:layout_width="match_parent" ns0:layout_height="52dp" ns0:layout_marginTop="22dp" ns0:background="@drawable/bg_button_primary" ns0:backgroundTint="@null" ns0:elevation="0dp" ns0:minHeight="0dp" ns0:paddingStart="10dp" ns0:paddingEnd="10dp" ns0:text="@string/about_bridgefy_open_website" ns0:textAllCaps="false" ns0:textColor="@color/button_primary_text" ns0:textSize="15sp" ns0:textStyle="bold" />
        
                        <Button ns0:id="@+id/buttonGetBridgefyApp" ns0:layout_width="match_parent" ns0:layout_height="52dp" ns0:layout_marginTop="12dp" ns0:background="@drawable/bg_button_secondary" ns0:backgroundTint="@null" ns0:elevation="0dp" ns0:minHeight="0dp" ns0:paddingStart="10dp" ns0:paddingEnd="10dp" ns0:text="@string/about_bridgefy_get_app" ns0:textAllCaps="false" ns0:textColor="@color/home_card_text" ns0:textSize="15sp" />
        
                    </LinearLayout>
        
                </LinearLayout>
        
            </ScrollView>
        
        
    </LinearLayout>
</merge>
