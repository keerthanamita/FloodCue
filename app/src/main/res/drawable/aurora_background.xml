<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/aurora_background" />

        </shape>
    </item>


    <!-- Violet Aurora glow -->
    <item
        android:top="-180dp"
        android:right="-120dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:startColor="@color/aurora_violet"
                android:centerColor="#668B5CF6"
                android:endColor="#00000000" />

        </shape>

    </item>


    <!-- Cyan Aurora glow -->
    <item
        android:bottom="-220dp"
        android:left="-160dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:startColor="@color/aurora_cyan"
                android:centerColor="#5522D3EE"
                android:endColor="#00000000" />

        </shape>

    </item>


    <!-- Blue Aurora glow -->
    <item
        android:top="180dp"
        android:left="-260dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:startColor="@color/aurora_blue"
                android:centerColor="#443B82F6"
                android:endColor="#00000000" />

        </shape>

    </item>

</layer-list>