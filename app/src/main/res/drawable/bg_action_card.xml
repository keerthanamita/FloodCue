<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/button_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_color" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/border_color" />
        </shape>
    </item>
</selector>
