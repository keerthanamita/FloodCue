<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_home_sos" />
            <corners android:radius="@dimen/fc_card_corner_radius" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_home_sos_pressed" />
            <corners android:radius="@dimen/fc_card_corner_radius" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_home_sos" />
            <corners android:radius="@dimen/fc_card_corner_radius" />
        </shape>
    </item>

</selector>
