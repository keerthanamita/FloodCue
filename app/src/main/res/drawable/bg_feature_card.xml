<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_surface_elevated" />
            <corners android:radius="@dimen/fc_card_corner_radius" />
            <stroke android:width="1dp" android:color="@color/fc_border" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_surface" />
            <corners android:radius="@dimen/fc_card_corner_radius" />
            <stroke android:width="1dp" android:color="@color/fc_border" />
        </shape>
    </item>

</selector>
