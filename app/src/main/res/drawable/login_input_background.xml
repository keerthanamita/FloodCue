<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_focused="true">

        <shape android:shape="rectangle">

            <solid android:color="@color/aurora_input_focused" />

            <stroke
                android:width="1dp"
                android:color="@color/aurora_blue" />

            <corners android:radius="18dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="@color/aurora_input" />

            <stroke
                android:width="1dp"
                android:color="@color/aurora_border" />

            <corners android:radius="18dp" />

        </shape>

    </item>

</selector>