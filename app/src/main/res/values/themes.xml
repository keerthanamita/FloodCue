<?xml version="1.0" encoding="utf-8"?>

<resources
    xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.FloodCue"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Main application colors -->
        <item name="colorPrimary">@color/button_primary</item>
        <item name="colorPrimaryVariant">@color/button_primary</item>
        <item name="colorSecondary">@color/button_primary</item>
        <item name="colorAccent">@color/button_primary</item>

        <!-- Error -->
        <item name="colorError">@color/error_color</item>

        <!-- Window -->
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <item name="android:windowBackground">@color/background_color</item>

        <!-- System bar appearance -->
        <item name="android:windowLightStatusBar">true</item>
        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="27">true</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans</item>

        <!-- Disable unnecessary action bar -->
        <item name="windowActionModeOverlay">true</item>

        <item name="textInputStyle">@style/FloodCueTextInputStyle</item>
    </style>
    <style name="FloodCueTextInputStyle"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="android:minHeight">56dp</item>
        <item name="hintTextColor">@color/text_secondary</item>

    </style>

    <style name="CollapsedHintTextStyle">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ExpandedHintTextStyle">
        <item name="android:textSize">15sp</item>
    </style>
    <!-- DO NOT CHANGE THIS. This is your existing Splash theme. -->
    <style
        name="Theme.FloodCue.Splash"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

</resources>