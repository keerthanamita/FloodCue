    <!-- About screens visible in the app language. -->
    <string name="about_title">About</string>
    <string name="about_app_name">FloodCue</string>
    <string name="about_app_description">Offline flood survival app for Android</string>

    <string name="about_language">Language</string>
    <string name="about_language_text">FloodCue keeps the app interface and the survival content on two separate languages. The app language controls menus, buttons, settings and screen text. The survival language controls the checklist, safety tips and emergency guide. Change either one in Settings → Change language.</string>

    <string name="about_floodcue_description">Flood survival, ready before the water arrives.</string>
    <string name="about_floodcue_features">What FloodCue does</string>
    <string name="about_floodcue_features_text">FloodCue keeps the information, warnings and messages you may need during a flood on your phone. It works without internet as much as possible, so you can prepare early, act quickly and ask for help even when the network is down.</string>
    <string name="about_floodcue_alerts">Flood alerts</string>
    <string name="about_floodcue_alerts_text">Official warnings from the NDMA SACHET public CAP feed, checked periodically in the background and announced with a loud alert notification. Where your own server key is configured, district rainfall warnings from the IMD are also included.</string>
    <string name="about_floodcue_sos">SOS and emergency message</string>
    <string name="about_floodcue_sos_text">Tap the SOS button to start the siren and send your help message with your location to your emergency contacts. You can also compose a custom emergency message and choose who receives it. A message queued while offline is sent automatically when a network returns.</string>
    <string name="about_floodcue_tips">Safety tips</string>
    <string name="about_floodcue_tips_text">Short, scannable tips for before, during and after a flood, with life-threatening warnings shown clearly.</string>
    <string name="about_floodcue_guide">Emergency guide</string>
    <string name="about_floodcue_guide_text">16 situation-based guides ordered by urgency, such as trapped inside a rising home, trapped in a vehicle, no phone network, dying phone battery, snakes in floodwater, contaminated water and attracting rescuers.</string>
    <string name="about_floodcue_offline_maps">Offline maps</string>
    <string name="about_floodcue_offline_maps_text">Download your district map once and open it without internet.</string>
    <string name="about_floodcue_about_bridgefy">Offline communication</string>
    <string name="about_floodcue_about_bridgefy_text">Bridgefy is a separate offline messaging app. FloodCue can guide you to install and open it before an emergency, but opening it does not add its messaging features inside FloodCue.</string>

    <string name="about_bridgefy_description">Connecting people when the internet fails</string>
    <string name="about_bridgefy_downloading">Downloading Bridgefy information…</string>
    <string name="about_bridgefy_install">Install Bridgefy</string>
    <string name="about_bridgefy_install_note">Install Bridgefy before an emergency, while you still have internet.</string>
    <string name="about_bridgefy_note">Bridgefy is a separate app. Opening it here opens the Google Play store listing; it does not add offline messaging inside FloodCue.</string>

